# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Build-time vendored binary. Fetched + SHA-256 verified by
# packaging/fetch_ripgrep.ps1; a 4 MB binary in git is permanent weight and
# every version bump would add another copy forever.
packaging/ripgrep/

# Virtual environments
.venv/
venv/
env/

# Testing
.coverage
htmlcov/
.pytest_cache/
pytest-cache-files-*/

# IDE
.vscode/
.idea/
.playwright-mcp/

# Resonant runtime
.resonant/

# Claude Code local state (machine-specific)
.claude/settings.local.json
.claude/*.lock

# Smoke harness output records at repo root (run-to-run drift; not baselines)
/smoke-*.json

# OS
.DS_Store
Thumbs.db
~$*

# Temp files
%TEMP%*
~/

# Packaging build artifacts and downloaded source archive
# (We vendor the extracted WinSparkle binaries but skip the .zip itself.)
packaging/winsparkle/WinSparkle.zip
